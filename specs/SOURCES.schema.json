{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/valkyoth/mynd/blob/main/specs/SOURCES.schema.json",
  "title": "Mynd specification source corpus",
  "description": "Identity, acquisition, legal disposition, and size limits for exact implementation references.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "pattern": "\\S"
    },
    "https_url": {
      "type": "string",
      "pattern": "^https://[^#\\s]+$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "publisher",
        "edition",
        "role",
        "disposition",
        "filename",
        "terms_url",
        "license",
        "max_bytes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]*$"
        },
        "title": {
          "$ref": "#/$defs/non_empty_string"
        },
        "publisher": {
          "$ref": "#/$defs/non_empty_string"
        },
        "edition": {
          "$ref": "#/$defs/non_empty_string"
        },
        "role": {
          "$ref": "#/$defs/non_empty_string"
        },
        "disposition": {
          "enum": [
            "public",
            "offline",
            "manual"
          ]
        },
        "filename": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
        },
        "download_url": {
          "$ref": "#/$defs/https_url"
        },
        "acquisition_url": {
          "$ref": "#/$defs/https_url"
        },
        "terms_url": {
          "$ref": "#/$defs/https_url"
        },
        "license": {
          "$ref": "#/$defs/non_empty_string"
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000000
        }
      },
      "oneOf": [
        {
          "properties": {
            "disposition": {
              "enum": [
                "public",
                "offline"
              ]
            }
          },
          "required": [
            "download_url"
          ],
          "not": {
            "required": [
              "acquisition_url"
            ]
          }
        },
        {
          "properties": {
            "disposition": {
              "const": "manual"
            }
          },
          "required": [
            "acquisition_url"
          ],
          "not": {
            "required": [
              "download_url"
            ]
          }
        }
      ]
    }
  }
}
